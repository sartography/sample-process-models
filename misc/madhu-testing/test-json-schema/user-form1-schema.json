        "options_from_task_data_var:fruitss"
      ]
    },
    "city": {
      "type": "string",
      "format": "date",
      "title": "Select a city"
    },
    "firstName": {
      "type": "string",
      "title": "First name",
      "default": "Chuck"
    }
  }
}