{
  "title": "Text Field",
  "description": "A simple text field that is required, has a default value, sets a placeholder, includes a description. (field name will be 'firstname')",
  "type": "object",
  "required": [
    "firstName"
  ],
  "properties": {
    "favoriteFruit": {
      "title": "Select your favorite fruit",
      "type": "string",
