      <bpmn:outgoing>Flow_1mtdmom</bpmn:outgoing>
      <bpmn:outgoing>Flow_08sdknf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1mzj4va" sourceRef="Gateway_06ykd4n" targetRef="assign_issue" />
    <bpmn:sequenceFlow id="Flow_0k5sxmn" sourceRef="Gateway_06ykd4n" targetRef="add_comment">
      <bpmn:conditionExpression>github_api_action == "add_comment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="update_status" name="Update status">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PatchRequestV2" resultVariable="update_status_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="base_issue_url" />
            <spiffworkflow:parameter id="headers" type="any" value="auth_headers" />
            <spiffworkflow:parameter id="data" type="any" value="updated_status" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1iwh0cx</bpmn:incoming>
      <bpmn:outgoing>Flow_0hwbhgq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1iwh0cx" sourceRef="Gateway_06ykd4n" targetRef="update_status">
      <bpmn:conditionExpression>github_api_action == "update_status"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hwbhgq" sourceRef="update_status" targetRef="Gateway_1bjm965" />
    <bpmn:sequenceFlow id="Flow_1mtdmom" sourceRef="Gateway_06ykd4n" targetRef="delete_comment">
      <bpmn:conditionExpression>github_api_action == "delete_comment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18y6574" sourceRef="delete_comment" targetRef="Gateway_1bjm965" />
    <bpmn:serviceTask id="delete_comment" name="Delete comment">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/DeleteRequestV2" resultVariable="delete_comment_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="f&#34;{delete_comment_url}/{comment_id}&#34;" />
            <spiffworkflow:parameter id="headers" type="any" value="auth_headers" />
            <spiffworkflow:parameter id="params" type="any" />
            <spiffworkflow:parameter id="data" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:instructionsForEndUser />
        <spiffworkflow:preScript />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mtdmom</bpmn:incoming>
      <bpmn:outgoing>Flow_18y6574</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0oe4xaj" name="Get Issue">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/GetRequestV2" resultVariable="get_issue_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="base_issue_url" />
            <spiffworkflow:parameter id="headers" type="any" value="auth_headers" />
            <spiffworkflow:parameter id="params" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
            <spiffworkflow:parameter id="attempts" type="int" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08sdknf</bpmn:incoming>
      <bpmn:outgoing>Flow_0woa1fo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_08sdknf" sourceRef="Gateway_06ykd4n" targetRef="Activity_0oe4xaj">
      <bpmn:conditionExpression>github_api_action == "get_issue"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0woa1fo" sourceRef="Activity_0oe4xaj" targetRef="Gateway_1bjm965" />
  </bpmn:process>
