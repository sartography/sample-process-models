  <bpmn:process id="Process_git_auth_test3" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_02rd7ug</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_02rd7ug" sourceRef="StartEvent_1" targetRef="setup_basic_variables" />
    <bpmn:endEvent id="Event_08y26wu">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>{{git_resp}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0m0w38a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10s5z0n" sourceRef="assign_issue" targetRef="Gateway_1bjm965" />
    <bpmn:serviceTask id="assign_issue" name="Assign Issue">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequestV2" resultVariable="assignment_result">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="assign_url" />
            <spiffworkflow:parameter id="headers" type="any" value="auth_headers" />
            <spiffworkflow:parameter id="data" type="any" value="assignees" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mzj4va</bpmn:incoming>
      <bpmn:outgoing>Flow_10s5z0n</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="setup_basic_variables" name="Setup basic variables">
      <bpmn:incoming>Flow_02rd7ug</bpmn:incoming>
      <bpmn:outgoing>Flow_1ctwmts</bpmn:outgoing>
      <bpmn:script>owner = "sartography"
repo = "spiff-arena"
issue_number = 1031
auth_headers = { "Authorization": "Bearer SPIFF_SECRET:github_oauth" }

base_issue_url = f"https://api.github.com/repos/{owner}/{repo}/issues/{issue_number}"

assign_url = f"{base_issue_url}/assignees"
assignees = {"assignees": ['madhurrya', 'madhusarto']}

add_comment_url = f"{base_issue_url}/comments"
comments = {"body": "This is the next comment on added from the github integration test."}

updated_status = {"state": "open"}

delete_comment_url = f"https://api.github.com/repos/{owner}/{repo}/issues/comments"</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="add_comment" name="Add comment">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequestV2" resultVariable="add_comment_response">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="add_comment_url" />
            <spiffworkflow:parameter id="headers" type="any" value="auth_headers" />
            <spiffworkflow:parameter id="data" type="any" value="comments" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k5sxmn</bpmn:incoming>
      <bpmn:outgoing>Flow_0gkm05n</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1bjm965">
      <bpmn:incoming>Flow_10s5z0n</bpmn:incoming>
      <bpmn:incoming>Flow_0gkm05n</bpmn:incoming>
      <bpmn:incoming>Flow_0hwbhgq</bpmn:incoming>
      <bpmn:incoming>Flow_18y6574</bpmn:incoming>
      <bpmn:incoming>Flow_0woa1fo</bpmn:incoming>
      <bpmn:outgoing>Flow_0m0w38a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0m0w38a" sourceRef="Gateway_1bjm965" targetRef="Event_08y26wu" />
    <bpmn:sequenceFlow id="Flow_0gkm05n" sourceRef="add_comment" targetRef="Gateway_1bjm965" />
    <bpmn:sequenceFlow id="Flow_1ctwmts" sourceRef="setup_basic_variables" targetRef="select_action" />
    <bpmn:sequenceFlow id="Flow_1b9d04e" sourceRef="select_action" targetRef="Gateway_06ykd4n" />
    <bpmn:userTask id="select_action" name="Select action">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="select-action-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="select-action-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ctwmts</bpmn:incoming>
      <bpmn:outgoing>Flow_1b9d04e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_06ykd4n" default="Flow_1mzj4va">
      <bpmn:incoming>Flow_1b9d04e</bpmn:incoming>
      <bpmn:outgoing>Flow_1mzj4va</bpmn:outgoing>
      <bpmn:outgoing>Flow_0k5sxmn</bpmn:outgoing>
