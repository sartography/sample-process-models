      <bpmn:outgoing>Flow_1qnse2p</bpmn:outgoing>
      <bpmn:outgoing>Flow_0a20qxl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1pege4c" sourceRef="User_Task" targetRef="Gateway_0whnerb" />
    <bpmn:sequenceFlow id="Flow_1qnse2p" sourceRef="Gateway_0whnerb" targetRef="Gateway_155u2w1">
      <bpmn:conditionExpression>ceo_on_leave</bpmn:conditionExpression>
