  <bpmn:process id="Process_Inclusive_Gateway_After_Exclusive_Gateway" isExecutable="true">
    <bpmn:userTask id="User_Task" name="Check CEO availability">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="ceo-on-leave-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="ceo-on-leave-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:postScript>if ceo_on_leave :
    operator_review_required = True
    supervisor_review_required = True
    finance_review_required = True</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ccudw1</bpmn:incoming>
      <bpmn:outgoing>Flow_1pege4c</bpmn:outgoing>
    </bpmn:userTask>
