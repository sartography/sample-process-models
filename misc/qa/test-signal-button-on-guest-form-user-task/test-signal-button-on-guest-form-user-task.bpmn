        <dc:Bounds x="200" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManualTask_ShowUrl_di" bpmnElement="ManualTask_ShowUrl">
        <dc:Bounds x="350" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_02pql7d_di" bpmnElement="Activity_0qpzdpu">
        <dc:Bounds x="500" y="137" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="660" y="159" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1b4r9f6_di" bpmnElement="Event_1b4r9f6">
        <dc:Bounds x="430" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0yabm0w_di" bpmnElement="Event_1mg8rob">
        <dc:Bounds x="540" y="199" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToGetUrl_di" bpmnElement="Flow_StartToGetUrl">
        <di:waypoint x="156" y="177" />
        <di:waypoint x="200" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetUrlToShowUrl_di" bpmnElement="Flow_GetUrlToShowUrl">
        <di:waypoint x="300" y="177" />
        <di:waypoint x="350" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShowUrlToGuestTask_di" bpmnElement="Flow_ShowUrlToGuestTask">
        <di:waypoint x="450" y="177" />
        <di:waypoint x="500" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GuestTaskToEnd_di" bpmnElement="Flow_GuestTaskToEnd">
