<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_96f6665" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="3.0.0-dev">
  <bpmn:process id="Process_test_signal_button_on_guest_form_user_task_yx0f14y" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_StartToGetUrl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="ScriptTask_GetUrl" name="Get Guest URL">
      <bpmn:incoming>Flow_StartToGetUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_GetUrlToShowUrl</bpmn:outgoing>
      <bpmn:script>guest_task_url = get_url_for_task_with_bpmn_identifier("Activity_0qpzdpu")</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:manualTask id="ManualTask_ShowUrl" name="Show URL for upcoming Guest task">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>## Guest Task URL

After you click Continue, the next task will be a guest task available at:

[{{guest_task_url}}]({{guest_task_url}})

Open it in an incognito or separate browser session once the process reaches that step. You'll need to submit the form there to trigger the signal button.</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GetUrlToShowUrl</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowUrlToGuestTask</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Activity_0qpzdpu" name="Guest User Task">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser />
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="name-schema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:allowGuest>true</spiffworkflow:allowGuest>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ShowUrlToGuestTask</bpmn:incoming>
      <bpmn:outgoing>Flow_GuestTaskToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_1mg8rob" attachedToRef="Activity_0qpzdpu">
      <bpmn:extensionElements>
        <spiffworkflow:signalButtonLabel>Cancel Form</spiffworkflow:signalButtonLabel>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_SignalToCancelled</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1uxvg02" signalRef="cancel" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>End</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GuestTaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1b4r9f6">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>Cancelled</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SignalToCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToGetUrl" sourceRef="StartEvent_1" targetRef="ScriptTask_GetUrl" />
    <bpmn:sequenceFlow id="Flow_GetUrlToShowUrl" sourceRef="ScriptTask_GetUrl" targetRef="ManualTask_ShowUrl" />
    <bpmn:sequenceFlow id="Flow_ShowUrlToGuestTask" sourceRef="ManualTask_ShowUrl" targetRef="Activity_0qpzdpu" />
    <bpmn:sequenceFlow id="Flow_GuestTaskToEnd" sourceRef="Activity_0qpzdpu" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_SignalToCancelled" sourceRef="Event_1mg8rob" targetRef="Event_1b4r9f6" />
  </bpmn:process>
  <bpmn:signal id="cancel" name="cancel">
    <bpmn:extensionElements>
      <spiffworkflow:variableName>cancel</spiffworkflow:variableName>
    </bpmn:extensionElements>
  </bpmn:signal>
