        <di:waypoint x="660" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SignalToCancelled_di" bpmnElement="Flow_SignalToCancelled">
        <di:waypoint x="558" y="235" />
