    <bpmn:sequenceFlow id="Flow_0vz7s9k" sourceRef="Activity_0pf9cbo" targetRef="Activity_1cmkqad" />
    <bpmn:serviceTask id="Activity_0pf9cbo" name="[DELETE] Delete Contact">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/DeleteRequestV2" resultVariable="deletecontact_info">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="deleteuserURL" />
            <spiffworkflow:parameter id="headers" type="any" value="iplicit_headers" />
            <spiffworkflow:parameter id="params" type="any" />
            <spiffworkflow:parameter id="data" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:preScript>deleteuserURL = "https://api.iplicit.com/api/Contact/" +userid;</spiffworkflow:preScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07wlz8y</bpmn:incoming>
      <bpmn:outgoing>Flow_0vz7s9k</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Activity_1cmkqad" name="Show Deleted Contact info">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>This is the response data: {{deletecontact_info}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vz7s9k</bpmn:incoming>
      <bpmn:outgoing>Flow_15wkymk</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_15wkymk" sourceRef="Activity_1cmkqad" targetRef="Activity_0q4bmp1" />
    <bpmn:sequenceFlow id="Flow_0qisb9z" sourceRef="Activity_0og4pa5" targetRef="Activity_13rz5g1" />
    <bpmn:serviceTask id="Activity_0og4pa5" name="Create session">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequestV2" resultVariable="session_info">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="&#34;https://api.iplicit.com/api/session/create/api&#34;" />
            <spiffworkflow:parameter id="headers" type="any" value="header" />
            <spiffworkflow:parameter id="data" type="any" value="request_body" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:preScript />
        <spiffworkflow:postScript>session_token = session_info["body"]["sessionToken"];</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00g8eoo</bpmn:incoming>
      <bpmn:outgoing>Flow_0qisb9z</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1amw19r" sourceRef="Activity_13rz5g1" targetRef="Activity_070lydz1" />
    <bpmn:serviceTask id="Activity_13rz5g1" name="Add Contact">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequestV2" resultVariable="contact_info">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="&#34;https://api.iplicit.com/api/Contact&#34;" />
            <spiffworkflow:parameter id="headers" type="any" value="iplicit_headers" />
            <spiffworkflow:parameter id="data" type="any" value="user_data" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:instructionsForEndUser>This is the session token: {{session_token }}</spiffworkflow:instructionsForEndUser>
        <spiffworkflow:preScript>auth_token = "Bearer " + session_token 
iplicit_headers = {
  "Content-Type": "application/json",
  "Domain": "sandbox.free.technology",
  "Authorization": auth_token
}</spiffworkflow:preScript>
        <spiffworkflow:postScript>userid = contact_info["body"];</spiffworkflow:postScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0qisb9z</bpmn:incoming>
      <bpmn:outgoing>Flow_1amw19r</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ot8vs1" sourceRef="Activity_0q4bmp1" targetRef="EndEvent_1" />
    <bpmn:serviceTask id="Activity_0q4bmp1" name="Close session">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PostRequestV2" resultVariable="resp">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="&#34;https://api.iplicit.com/api/Session/close&#34;" />
            <spiffworkflow:parameter id="headers" type="any" value="iplicit_headers" />
            <spiffworkflow:parameter id="data" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15wkymk</bpmn:incoming>
      <bpmn:outgoing>Flow_1ot8vs1</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
