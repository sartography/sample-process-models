    <bpmn:sequenceFlow id="Flow_163jqf2" sourceRef="Activity_070lydz1" targetRef="Activity_15jdyld1" />
    <bpmn:serviceTask id="Activity_070lydz1" name="[GET] Get Contact">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/GetRequestV2" resultVariable="contact_resp">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="getuserURL" />
            <spiffworkflow:parameter id="headers" type="any" value="iplicit_headers" />
            <spiffworkflow:parameter id="params" type="any" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
            <spiffworkflow:parameter id="attempts" type="int" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:instructionsForEndUser>User id is {{userid }}</spiffworkflow:instructionsForEndUser>
        <spiffworkflow:postScript />
        <spiffworkflow:preScript>getuserURL = "https://api.iplicit.com/api/Contact/" +userid;</spiffworkflow:preScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1amw19r</bpmn:incoming>
      <bpmn:outgoing>Flow_163jqf2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_00g8eoo" sourceRef="Activity_1bun2pl1" targetRef="Activity_0og4pa5" />
    <bpmn:scriptTask id="Activity_1bun2pl1" name="Set params">
      <bpmn:incoming>Flow_17db3yp</bpmn:incoming>
      <bpmn:outgoing>Flow_00g8eoo</bpmn:outgoing>
      <bpmn:script>
request_body = {
  "username": "non-prod-spiff",
  "userApiKey": "SPIFF_SECRET:IPLICIT_API_KEY"
}

header = {
  "Content-Type": "application/json",
  "Domain": "sandbox.free.technology"
}

user_data = {
  "firstName": "Madhu",
  "lastName": "Test1"
}

user_data2 = {
  "firstName": "Madhu",
  "lastName": "Test1Updated"
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_19nboee" sourceRef="Activity_15jdyld1" targetRef="Activity_1w6hz0p" />
    <bpmn:manualTask id="Activity_15jdyld1" name="Show Contact info">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>This is the response data: {{contact_resp}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_163jqf2</bpmn:incoming>
      <bpmn:outgoing>Flow_19nboee</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_1i47vl5" sourceRef="Activity_1w6hz0p" targetRef="Activity_1mplmxd" />
    <bpmn:serviceTask id="Activity_1w6hz0p" name="[PATCH] Update Contact">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="http/PatchRequestV2" resultVariable="updatecontact_info">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="url" type="str" value="updateuserURL" />
            <spiffworkflow:parameter id="headers" type="any" value="iplicit_headers" />
            <spiffworkflow:parameter id="data" type="any" value="user_data2" />
            <spiffworkflow:parameter id="basic_auth_username" type="str" />
            <spiffworkflow:parameter id="basic_auth_password" type="str" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
        <spiffworkflow:preScript>updateuserURL = "https://api.iplicit.com/api/Contact/" +userid;</spiffworkflow:preScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19nboee</bpmn:incoming>
      <bpmn:outgoing>Flow_1i47vl5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Activity_1mplmxd" name="Show Updated Contact info">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>This is the response data: {{updatecontact_info}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i47vl5</bpmn:incoming>
      <bpmn:outgoing>Flow_07wlz8y</bpmn:outgoing>
    </bpmn:manualTask>
