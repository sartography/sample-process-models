      <bpmn:outgoing>Flow_12pkbxb</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Enter_PR_URL" name="Enter PR URL">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="pr-url-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="pr-url-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:allowGuest>true</spiffworkflow:allowGuest>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zm9lnq</bpmn:incoming>
      <bpmn:outgoing>Flow_1tmq2un</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_09ovp60" name="Get Guest Task URL">
      <bpmn:incoming>Flow_12pkbxb</bpmn:incoming>
      <bpmn:outgoing>Flow_0zm9lnq</bpmn:outgoing>
      <bpmn:script># Generate guest user task URL
guest_task_url = get_url_for_task_with_bpmn_identifier("Enter_PR_URL")</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:manualTask id="Activity_1niluz7" name="Display PR URL">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>PR URL : {{pr_url}}

Comment: {{comment}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tmq2un</bpmn:incoming>
      <bpmn:outgoing>Flow_07kwp86</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_1">
