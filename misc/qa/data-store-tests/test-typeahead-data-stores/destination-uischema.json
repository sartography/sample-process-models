{
    "city": {
        "ui:widget": "typeahead",
        "ui:options": {
            "category": "cities",
            "itemFormat": "{name} ({state}, {country})"
        }
    },
    "state": {
        "ui:widget": "typeahead",
        "ui:options": {
            "category": "states",
            "itemFormat": "{name} ({country})"
        }
    },
    "country": {
        "ui:widget": "typeahead",
        "ui:options": {
            "category": "countries",
            "itemFormat": "{name}"
        }
    } ,
    "ui:order": [
        "city",
        "state",
        "country" 
    ]
}
