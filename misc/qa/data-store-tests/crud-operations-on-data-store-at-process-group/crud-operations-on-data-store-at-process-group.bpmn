      </bpmn:dataOutputAssociation>
      <bpmn:script>first_name =  empname.split()[0]
middle_name =  middleName  
last_name = empname.split()[1]
fullname = first_name + " " + middleName + " " + last_name

employees =   { 
    "001" : {  
            "name" :fullname
        }    
  }



</bpmn:script>
