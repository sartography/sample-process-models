          <bpmn:inputDataItem id="x" name="x" />
          <bpmn:outputDataItem id="y" name="y" />
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:script>y = x</bpmn:script>
      </bpmn:scriptTask>
