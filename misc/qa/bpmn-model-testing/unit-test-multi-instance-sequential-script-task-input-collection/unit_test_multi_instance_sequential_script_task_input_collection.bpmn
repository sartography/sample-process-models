    <bpmn:sequenceFlow id="Flow_0oin4j8" sourceRef="Activity_1yp62ws" targetRef="Activity_0h6eb00" />
    <bpmn:endEvent id="Event_1vawsr7">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>End Multi Instance Sequential Script Task Unit Test. Output Collection: {{z}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xhbvhh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1xhbvhh" sourceRef="Activity_0h6eb00" targetRef="Event_1vawsr7" />
    <bpmn:scriptTask id="Activity_1yp62ws" name="Initializing Script Task">
      <bpmn:incoming>Flow_1jv05nl</bpmn:incoming>
      <bpmn:outgoing>Flow_0oin4j8</bpmn:outgoing>
      <bpmn:script>mylist = ["apple", "banana", "cherry", "orange",  "pears", "avacado"]</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0h6eb00" name="Sequential Multi Instance Scrip Task">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oin4j8</bpmn:incoming>
      <bpmn:outgoing>Flow_1xhbvhh</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopDataInputRef>mylist</bpmn:loopDataInputRef>
        <bpmn:loopDataOutputRef>z</bpmn:loopDataOutputRef>
        <bpmn:inputDataItem id="x" name="x" />
        <bpmn:outputDataItem id="y" name="y" />
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">x == "cherry"</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:script>y = 'I love ' + x</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
