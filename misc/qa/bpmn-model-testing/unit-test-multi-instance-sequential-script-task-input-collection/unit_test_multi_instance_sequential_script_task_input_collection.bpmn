  <bpmn:process id="Unit_Test_Multi_Instance_sequential_script_task_input_collection" name="Unit Test Multi Instance sequential script task input collection" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1jv05nl</bpmn:outgoing>
    </bpmn:startEvent>
