    <bpmn:endEvent id="Event_0z6gmxk">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>End Multi Instance Sequential User Task Input Collection Unit Test.
{{Colors}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cswees</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0cswees" sourceRef="Activity_0lc3y86" targetRef="Event_0z6gmxk" />
    <bpmn:scriptTask id="Activity_10kc46y" name="Initializing Script Task">
      <bpmn:incoming>Flow_0oqfdx1</bpmn:incoming>
      <bpmn:outgoing>Flow_18upo9k</bpmn:outgoing>
      <bpmn:script>products = { }
products[f'item_{len(products) + 1}'] = {
'product_name': "Product1",
'product_quantity': 3,
'product_color': "blue",
'product_size': 5,
'product_style': "ttt",
'product_price': 44,
}
products[f'item_{len(products) + 1}'] = {
'product_name': "Product2",
'product_quantity': 6,
'product_color': "red",
'product_size': 33,
'product_style': "hhh",
'product_price': 77,
}
products[f'item_{len(products) + 1}'] = {
'product_name': "Product3",
'product_quantity': 3,
'product_color': "black",
'product_size': 1,
'product_style': "hhh",
'product_price': 400,
}

products[f'item_{len(products) + 1}'] = {
'product_name': "Product4",
'product_quantity': 6,
'product_color': "green",
'product_size': 24,
'product_style': "hhh",
'product_price': 3,
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_0lc3y86" name="Sequential multi-instance user task">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formUiSchemaFilename" value="what-color-is-uischema.json" />
          <spiffworkflow:property name="formJsonSchemaFilename" value="what-color-is-schema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:instructionsForEndUser>product {{product}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18upo9k</bpmn:incoming>
      <bpmn:outgoing>Flow_0cswees</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopDataInputRef>products</bpmn:loopDataInputRef>
        <bpmn:loopDataOutputRef>Colors</bpmn:loopDataOutputRef>
        <bpmn:inputDataItem id="product" name="product" />
        <bpmn:outputDataItem id="color" name="color" />
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">product["product_color"]=="black"</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
  </bpmn:process>
