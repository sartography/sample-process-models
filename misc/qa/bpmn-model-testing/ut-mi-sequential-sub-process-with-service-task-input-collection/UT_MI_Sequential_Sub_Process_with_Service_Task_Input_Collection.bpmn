      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0zvpwvw" sourceRef="Service_Task" targetRef="Event_0r7kzvc" />
      <bpmn:serviceTask id="Service_Task" name="Service Task">
        <bpmn:extensionElements>
          <spiffworkflow:instructionsForEndUser>This is the Service Task Unit Test Screen.</spiffworkflow:instructionsForEndUser>
          <spiffworkflow:serviceTaskOperator id="http/GetRequest" resultVariable="git_resp">
            <spiffworkflow:parameters>
              <spiffworkflow:parameter id="basic_auth_password" type="str" />
              <spiffworkflow:parameter id="basic_auth_username" type="str" />
              <spiffworkflow:parameter id="headers" type="any" value="{ &#34;Authorization&#34;: &#34;Bearer SPIFF_SECRET:github_oauth&#34; }" />
              <spiffworkflow:parameter id="params" type="any" />
              <spiffworkflow:parameter id="url" type="str" value="&#34;https://api.github.com/user&#34;" />
            </spiffworkflow:parameters>
          </spiffworkflow:serviceTaskOperator>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1vd9v5m</bpmn:incoming>
        <bpmn:outgoing>Flow_0zvpwvw</bpmn:outgoing>
      </bpmn:serviceTask>
    </bpmn:subProcess>
    <bpmn:scriptTask id="Activity_1y63kwn" name="Initializing Script Task">
      <bpmn:incoming>Flow_0d8r9d8</bpmn:incoming>
      <bpmn:outgoing>Flow_1651y1w</bpmn:outgoing>
      <bpmn:script>mycounter=[1,2,3,4]</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1651y1w" sourceRef="Activity_1y63kwn" targetRef="MI_Sequential_Sub_Process" />
    <bpmn:endEvent id="Event_0wbfqtg">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>End MI Sequential Sub Process with Service Task Input Collection Unit Test. Output: {{git_resp.id}}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mevjep</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0mevjep" sourceRef="MI_Sequential_Sub_Process" targetRef="Event_0wbfqtg" />
  </bpmn:process>
