  <bpmn:process id="UT_MI_Sequential_Sub_Process_with_Service_Task_Input_Collection" name="MI Sequential Sub Process with Service Task Input Collection" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0d8r9d8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0d8r9d8" sourceRef="StartEvent_1" targetRef="Activity_1y63kwn" />
    <bpmn:subProcess id="MI_Sequential_Sub_Process" name="MI Sequential Sub Process with Service Task ">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1651y1w</bpmn:incoming>
      <bpmn:outgoing>Flow_0mevjep</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopDataInputRef>mycounter</bpmn:loopDataInputRef>
        <bpmn:loopDataOutputRef>z</bpmn:loopDataOutputRef>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Event_1k8k42t">
