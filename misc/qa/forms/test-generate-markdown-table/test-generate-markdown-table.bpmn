      <bpmn:script>#define table fields
fields = [
                {'property': 'name', 'label': 'Name','sanitize':True},
                {'property': 'description', 'label': 'Task Description','sanitize':True},
                {'property': 'date', 'label': 'Date', 'formatter':'convert_seconds_to_date_time_for_display'}, 
                {'property': 'completed', 'label': 'Task Completed', },
                {'property': 'amount', 'label': 'Amount, USD ($)'},
                {'property': 'url', 'label': 'URL','sanitize':True}
        ];


#create record list
records = []

for x in tasks:
        #create each reacod
        new_record = {} 
        new_record["name"] = x["name"]   
        new_record["description"] = x["description"]    
        new_record["date"] = datetime.strptime(x["start_date"], '%Y-%m-%d').timestamp()
        new_record["completed"] = {True: "YES", False: "NO"} [x["done"]]   
        new_record["amount"] = x["amount"]   
        new_record["url"] = x["url"]    
        # Add to record list
        records.append(new_record)
 
#generate mark down table 
markdown_table = generate_markdown_table(fields,records)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0h2b7k8" sourceRef="Activity_0prxt64" targetRef="EndEvent_1" />
    <bpmn:manualTask id="Activity_0prxt64" name="Display Data">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>{{markdown_table}}

{{delta}}</spiffworkflow:instructionsForEndUser>
