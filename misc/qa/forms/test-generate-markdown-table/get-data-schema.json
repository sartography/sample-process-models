{
  "title": "Nested Form / Repeating Section",
  "description": "Allow the form submitter to add multiple entries for a set of fields.",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "title": "Tasks",
      "items": {
        "type": "object",
        "required": [
          "name","description", 
          "start_date", 
          "amount","url"
        ],
        "properties": {
            "name": {
                "type": "string",
                "title": "Name",
                "description": "Your name" 
            },
            "description": {
                "type": "string",
                "title": "Description",
                "description": "Please describe the task to complete"
            },
            "done": {
                "type": "boolean",
                "title": "Done?",
                "default": false
            },
            "start_date": {
                "type": "string", 
                "title": "Start Date" 
            }, 
            "amount": {
                "type": "number",
                "title": "Amount"
            },
            "url": {
                "type": "string",
                "title": "URL"
            }
        }
      }
    }
  }
}