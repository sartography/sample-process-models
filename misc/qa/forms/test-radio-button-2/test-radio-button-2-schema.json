{
  "title": "A Simple Form to test Radio Buttons",
  "description": "Simple Radio button with multiple options",
  "properties": {
     "schoolyear": {
      "title": "What is your school year? (Required*)",
      "type": "number",
      "oneOf": [
        {
          "const": 10,
          "title": "Freshman"
        },
        {
          "const": 20,
          "title": "Sophomore"
        },
        {
          "const": 30,
          "title": "Junior"
        },
        {
          "const": 40,
          "title": "Senior"
        }
      ]
    },
    "my_number": {
      "title": "Select number? (Not Required)",
      "type": "number",
      "oneOf": [
        {
          "type": "number",
          "title": "One",
          "enum": [1]
        },
        {
          "type": "number",
          "title": "2",
          "enum": [2]
        },
        {
          "type": "number",
          "title": "Num 3",
          "enum": [3]
        }
      ]
    }
  },
  "required": [
    "schoolyear"
  ]
}