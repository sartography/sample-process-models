    <bpmn:laneSet id="LaneSet_06wu5sq">
      <bpmn:lane id="Lane_Reviewer" name="Reviewer">
        <bpmn:flowNodeRef>Activity_GetMoreData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GatherData</bpmn:flowNodeRef>
      </bpmn:lane>
