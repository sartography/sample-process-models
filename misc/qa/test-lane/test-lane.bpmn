    </bpmn:endEvent>
    <bpmn:userTask id="Activity_GetData" name="Get Data">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="getdata-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="getdata-uischema.json" />
        </spiffworkflow:properties>
        <spiffworkflow:preScript>current_user = get_current_user()['username']</spiffworkflow:preScript>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1loqmjv</bpmn:incoming>
      <bpmn:outgoing>Flow_0c8hg1n</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Activity_Approve" name="Approve">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>## Approve
### Data
{{ data }}</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05yh1lx</bpmn:incoming>
      <bpmn:outgoing>Flow_0u3xyg5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:scriptTask id="Activity_GetReviewers" name="Get Reviewers">
      <bpmn:incoming>Flow_1msk5h9</bpmn:incoming>
      <bpmn:outgoing>Flow_1loqmjv</bpmn:outgoing>
      <bpmn:script>lane_owners = {"Reviewer": ["security.project-lead@status.im", "fin@status.im"]}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1msk5h9" sourceRef="StartEvent_1" targetRef="Activity_GetReviewers" />
    <bpmn:sequenceFlow id="Flow_0u3xyg5" sourceRef="Activity_Approve" targetRef="Event_09rkmlh" />
    <bpmn:sequenceFlow id="Flow_1loqmjv" sourceRef="Activity_GetReviewers" targetRef="Activity_GetData" />
    <bpmn:userTask id="Activity_GetMoreData" name="Get More Data">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="getmoredata-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="getmoredata-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0c8hg1n</bpmn:incoming>
      <bpmn:outgoing>Flow_1xtmg0t</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_GatherData" name="Gather Data">
      <bpmn:incoming>Flow_1xtmg0t</bpmn:incoming>
      <bpmn:outgoing>Flow_05yh1lx</bpmn:outgoing>
      <bpmn:script>data = {"firstName": firstName, "bio": bio}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1xtmg0t" sourceRef="Activity_GetMoreData" targetRef="Activity_GatherData" />
  </bpmn:process>
