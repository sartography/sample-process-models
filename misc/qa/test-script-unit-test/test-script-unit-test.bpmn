    <bpmn:userTask id="Activity_1bkpr08" name="User Task">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="price-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="price-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17db3yp</bpmn:incoming>
