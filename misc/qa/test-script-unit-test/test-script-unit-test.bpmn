    <bpmn:scriptTask id="Activity_09vnash" name="Script Task">
      <bpmn:extensionElements>
        <spiffworkflow:unitTests>
          <spiffworkflow:unitTest id="test_case2">
            <spiffworkflow:inputJson>{
  "qty": 2,
  "item_name": "item2",
  "item_price": 120,
  "total_price": 240,
  "discount_rate": 10,
  "discounted_amount": 216,
  "no_of_installments": 6 
}</spiffworkflow:inputJson>
            <spiffworkflow:expectedOutputJson>{
  "qty": 2,
  "item_name": "item2",
  "item_price": 120,
  "total_price": 240,
  "discount_rate": 10,
  "discounted_amount": 216,
  "no_of_installments": 6,
  "amount_per_installment": 36
}</spiffworkflow:expectedOutputJson>
          </spiffworkflow:unitTest>
          <spiffworkflow:unitTest id="test_case3">
            <spiffworkflow:inputJson>{
  "qty": 5,
  "item_name": "item3",
  "item_price": 30,
  "total_price": 150,
  "discount_rate": 5,
  "discounted_amount": 142.5,
  "no_of_installments": 3 
}</spiffworkflow:inputJson>
            <spiffworkflow:expectedOutputJson>{
  "qty": 5,
  "item_name": "item3",
  "item_price": 30,
  "total_price": 150,
  "discount_rate": 5,
  "discounted_amount": 142.5,
  "no_of_installments": 3,
  "amount_per_installment": 47.5
}</spiffworkflow:expectedOutputJson>
          </spiffworkflow:unitTest>
          <spiffworkflow:unitTest id="test_case1">
            <spiffworkflow:inputJson>{
  "qty": 1,
  "item_name": "item1",
  "item_price": 50,
  "total_price": 50,
  "discount_rate": 12.123,
  "discounted_amount": 43.9385,
  "no_of_installments": 6 
}</spiffworkflow:inputJson>
            <spiffworkflow:expectedOutputJson>{
  "qty": 1,
  "item_name": "item1",
  "item_price": 50,
  "total_price": 50,
  "discount_rate": 12.123,
  "discounted_amount": 43.9385,
  "no_of_installments": 6,
  "amount_per_installment": 7.32
}</spiffworkflow:expectedOutputJson>
          </spiffworkflow:unitTest>
        </spiffworkflow:unitTests>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vdre2v</bpmn:incoming>
      <bpmn:outgoing>Flow_0fxn6ay</bpmn:outgoing>
      <bpmn:script>total_price = item_price * qty
discounted_amount = total_price - (total_price*(discount_rate/100))
amount_per_installment =round(discounted_amount/no_of_installments,2)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:manualTask id="Activity_18h3met" name="Manual Task">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser>Item: {{item_name}}

Price ($): {{item_price}}

Quantity: {{qty}}

Discount Rate: {{discount_rate}}%

Number of Installments: {{no_of_installments}}

**Amount Per Installment is ${{amount_per_installment}}**</spiffworkflow:instructionsForEndUser>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fxn6ay</bpmn:incoming>
      <bpmn:outgoing>Flow_0wc44gm</bpmn:outgoing>
    </bpmn:manualTask>
  </bpmn:process>
