{
  "title": "Installment Payment Calculator",
  "description": "Calculates the amount to be paid for each installment",
  "type": "object",
  "required": [
    "item_name","item_price","qty",
    "discount_rate","no_of_installments"
  ],
  "properties": {
    "item_name": {
      "type": "string",
      "title": "Item Name" 
    },
    "item_price": {
      "type": "number",
      "title": "Item Price" 
    },
     "qty": {
      "type": "number",
      "title": "Quantity" 
    },
    "discount_rate": {
      "type": "number",
      "title": "Discount Rate",
      "minimum" : 1,
      "maximum" : 100 
    },
    "no_of_installments": {
      "type": "number",
      "title": "No of Installments" ,
      "minimum" : 1,
      "maximum" : 12
    }
  }
}