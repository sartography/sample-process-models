      <bpmn:scriptTask id="Activity_0fb1aso" name="Get Job Title Enum list">
        <bpmn:incoming>Flow_0ab7ec8</bpmn:incoming>
        <bpmn:outgoing>Flow_007xkbg</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0tm01zi" sourceRef="Gateway_1gn8mp1" targetRef="Activity_0yu0shl" />
      <bpmn:callActivity id="Activity_0yu0shl" name="Get BBHR Project/Program Enum List" calledElement="Which_Bamboo_Depart_Div_Data">
        <bpmn:extensionElements>
          <spiffworkflow:preScript># Set Task Name
which_bamboo_depart_div_data_rule = "Division &amp; Department Enum Lists"

# Set Exclude Departments with No Employees Flag
is_exclude_departments_with_no_employees = True</spiffworkflow:preScript>
          <spiffworkflow:postScript># Exclude non-Project departments 
## 19125 - Co-founders, 19004 - Program Leads
dept_enum_list = [x for x in dept_enum_list if x["value"] not in ["18589", "19125", "19004"]]

# Add "new project" value to the dept enum
new_department = {"label": "New project", "value": "99999"}
dept_enum_list.insert(0, new_department)

# Create Department/Project list with no new project
dept_enum_list_nn = [x for x in dept_enum_list if x["value"] != "99999"]

# Add "new program" value to the div enum
new_division = {"label": "New program", "value": "99999"}
div_enum_list.insert(0, new_division)

# Create Division/Program list with no new program
div_enum_list_nn = [x for x in div_enum_list if x["value"] != "99999"]

del(which_bamboo_depart_div_data_rule)
del(employee_divisions)
del(new_division)
del(new_department)</spiffworkflow:postScript>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0tm01zi</bpmn:incoming>
        <bpmn:outgoing>Flow_02a4oo5</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_02a4oo5" sourceRef="Activity_0yu0shl" targetRef="Gateway_155nzbj" />
      <bpmn:scriptTask id="Activity_1xerteh" name="Set Currency Type Enum List">
        <bpmn:incoming>Flow_1rs8oji</bpmn:incoming>
        <bpmn:outgoing>Flow_03s01hq</bpmn:outgoing>
        <bpmn:script># Set Default Currency Type
# nrr_details["currency_type"] = "fiat"

# Set Default Currency
# nrr_details["currency"] = "USD"</bpmn:script>
      </bpmn:scriptTask>
