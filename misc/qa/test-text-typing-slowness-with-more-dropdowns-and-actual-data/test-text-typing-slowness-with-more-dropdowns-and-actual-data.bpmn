      <bpmn:incoming>Flow_17db3yp</bpmn:incoming>
      <bpmn:outgoing>Flow_1mwdejb</bpmn:outgoing>
      <bpmn:script>job_titles_enum_list = [
    {
      "label": "None from the listed options - add option",
      "value": "none"
    }
  ];
job_titles_enum_list_nn = [
    {
      "label": "Accounting Consultant",
      "value": "product_designer"
    }
  ];
pro_levels_enum_list = [
    {
      "label": "",
      "value": ""
    }
  ]; 
dept_enum_list = [
    {
      "label": "Codex",
      "value": "18575"
    }
  ];
dept_enum_list_nn = [
    {
      "label": "Codex",
      "value": "18575"
    }
  ];
div_enum_list = [
    {
      "label": "New program",
      "value": "99999"
    }
  ]; 
div_enum_list_nn =[
    {
      "label": "New program",
      "value": "99999"
    }
  ]; </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_0qpzdpu" name="Example manual task">
      <bpmn:extensionElements>
        <spiffworkflow:instructionsForEndUser />
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="data-schema.json" />
