{
  "type": "object",
  "properties": {
    "repeat": {
      "title": "Do you expect more expenses to come under the selected Goods/Services request?",
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    }
  },
  "required": ["repeat"],
  "if": {
    "properties": {
      "repeat": {
        "const": "no"
      }
    },
    "required": ["repeat"]
  },
  "then": {
    "properties": {
      "confirm": {
        "title": "Are you sure? No more expenses can be uploaded for this purchase request",
        "type": "string",
        "enum": [
          "yes",
          "no, changed my mind"
        ]
      }
    },
    "required": ["confirm"]
  }
}
