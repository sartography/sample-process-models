      <bpmn:incoming>Flow_1msk5h9</bpmn:incoming>
      <bpmn:outgoing>Flow_1loqmjv</bpmn:outgoing>
      <bpmn:script>lane_owners = {"Reviewer": ["admin@spiffworkflow.org", "nelson@spiffworkflow.org"]}</bpmn:script>
