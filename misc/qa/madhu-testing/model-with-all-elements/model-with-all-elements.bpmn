      <bpmn:conditionExpression>approval == "Needmoreinfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:manualTask id="Activity_GetMoreData" name="Show Data">
      <bpmn:extensionElements>
